# --- WhatsApp Cloud API (from Meta for Developers > your App > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=paste_your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=paste_the_phone_number_id_here
# Any string you make up yourself — you'll type this same value into the Meta webhook setup screen
WHATSAPP_VERIFY_TOKEN=choose-any-secret-word-here
# Optional but recommended once things work: App Secret, used to verify webhook calls really come from Meta
WHATSAPP_APP_SECRET=

# --- Claude (from console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=paste_your_anthropic_api_key_here
# Cheap + fast + plenty smart enough for this job. Leave as-is unless you know you want a different model.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Firebase (same project as the Reseller Ledger app) ---
# Firebase Console > Project Settings > Service Accounts > "Generate new private key".
# Paste the ENTIRE downloaded JSON file content here as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Misc ---
# Which company this WhatsApp number is for, if you're only running one number for now.
# Leave blank to have the bot ask each new customer which company they're with.
DEFAULT_COMPANY=

PORT=3000
